# --- 비밀값 --------------------------------------------------------------------
# .env.example 만 커밋한다. 실제 값이 들어간 파일은 전부 제외.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
# 구글 서비스 계정 JSON 등
service-account*.json
credentials*.json
gha-creds-*.json

# --- 파이썬 --------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
eggs/
.eggs/
sdist/
wheels/
*.egg-info/
*.egg
.installed.cfg
MANIFEST

# 가상환경
.venv/
venv/
ENV/

# 테스트·검사 캐시
.pytest_cache/
.mypy_cache/
.dmypy.json
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.cover

# --- Node / Next.js ------------------------------------------------------------
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- 데이터베이스 백업 ------------------------------------------------------------
# 덤프에는 고객 데이터 전체가 들어 있다. 절대 커밋하지 않는다.
*.dump
*.sql.gz
*.dump.sha256

# --- 산출물 · 임시파일 -----------------------------------------------------------
/tmp/
*.log
*.pid

# --- 에디터 · OS ---------------------------------------------------------------
.DS_Store
Thumbs.db
