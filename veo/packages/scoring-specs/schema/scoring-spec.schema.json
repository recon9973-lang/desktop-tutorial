{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veo.seokorea.org/schemas/scoring-spec/v1.json",
  "title": "VEO Scoring Specification",
  "description": "Versioned, machine-readable scoring specification authored by VEO-LAB and implemented by VENOM. Weights, severities and caps MUST live here and never inside checker code.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec_id",
    "domain",
    "version",
    "status",
    "effective_at",
    "methodology_owner",
    "implementation_owner",
    "score_meaning",
    "severity_coefficients",
    "confidence_levels",
    "status_policy",
    "url_importance",
    "categories",
    "bands"
  ],
  "properties": {
    "spec_id": {
      "type": "string",
      "pattern": "^veo\\.[a-z0-9_]+(\\.[a-z0-9_]+)*$",
      "description": "Stable identifier of the specification family, e.g. veo.seo.readiness"
    },
    "domain": {
      "type": "string",
      "enum": [
        "SEO_READINESS",
        "GEO_READINESS"
      ],
      "description": "GEO_OBSERVATION is deliberately absent: observed AI visibility is measured, not scored by this evaluator."
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "REVIEW",
        "APPROVED",
        "PUBLISHED",
        "RETIRED"
      ]
    },
    "effective_at": {
      "type": "string",
      "format": "date-time"
    },
    "methodology_owner": {
      "type": "string"
    },
    "implementation_owner": {
      "type": "string"
    },
    "approved_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "compatible_collector_versions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "score_meaning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ko",
        "en",
        "is_rank_prediction"
      ],
      "properties": {
        "ko": {
          "type": "string"
        },
        "en": {
          "type": "string"
        },
        "is_rank_prediction": {
          "type": "boolean",
          "const": false,
          "description": "VEO readiness scores are never rank predictions."
        }
      }
    },
    "changelog": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "date",
          "summary"
        ],
        "properties": {
          "version": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "summary": {
            "type": "string"
          }
        }
      }
    },
    "severity_coefficients": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "BLOCKER",
        "CRITICAL",
        "MAJOR",
        "MINOR",
        "INFO"
      ],
      "properties": {
        "BLOCKER": {
          "$ref": "#/$defs/unitInterval"
        },
        "CRITICAL": {
          "$ref": "#/$defs/unitInterval"
        },
        "MAJOR": {
          "$ref": "#/$defs/unitInterval"
        },
        "MINOR": {
          "$ref": "#/$defs/unitInterval"
        },
        "INFO": {
          "$ref": "#/$defs/unitInterval"
        }
      }
    },
    "confidence_levels": {
      "type": "object",
      "description": "Evidence strength of a check outcome. Direct observation is the only 1.0.",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/unitInterval"
      }
    },
    "status_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fail_penalty_multiplier",
        "warning_penalty_multiplier",
        "pass_penalty_multiplier",
        "not_applicable",
        "unknown"
      ],
      "properties": {
        "fail_penalty_multiplier": {
          "$ref": "#/$defs/unitInterval"
        },
        "warning_penalty_multiplier": {
          "$ref": "#/$defs/unitInterval"
        },
        "pass_penalty_multiplier": {
          "$ref": "#/$defs/unitInterval"
        },
        "not_applicable": {
          "type": "string",
          "const": "EXCLUDE_FROM_DENOMINATOR",
          "description": "N/A is not zero. It leaves both numerator and denominator."
        },
        "unknown": {
          "type": "string",
          "enum": [
            "EXCLUDE_FROM_SCORE_REDUCE_COVERAGE",
            "SCORE_AS_ZERO_KEEP_IN_DENOMINATOR"
          ],
          "description": "How an unmeasurable check is scored. EXCLUDE_FROM_SCORE_REDUCE_COVERAGE removes it from the budget and lowers coverage instead, so the score is relative to what could be measured. SCORE_AS_ZERO_KEEP_IN_DENOMINATOR keeps its weight in the denominator and earns nothing, so 100 stays a fixed total: a site that could not be measured cannot score as if it had been. Either way the check is never reported as a failure of the site."
        },
        "breadth_exponent": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "description": "결함이 퍼진 범위를 감점에 반영하는 지수. 1.0 은 선형이고 기본값이다. 1보다 작으면 넓게 퍼진 결함을 선형보다 무겁게 본다 — 웹사이트의 결함은 대개 템플릿 단위로 생기므로 40% 실패는 나머지 60% 도 같은 위험 위에 있다는 뜻이다."
        },
        "not_sampled": {
          "type": "string",
          "enum": [
            "EXCLUDE_FROM_DENOMINATOR"
          ],
          "description": "표본 정책이 재지 않기로 한 대상의 셈법(1.9.0 신설). 분모·측정 범위에서 빠지고 '표본 밖 — 요청 시 측정'으로 따로 표기된다. sampling.*.check_ids 를 선언한 판에서는 필수다."
        }
      }
    },
    "url_importance": {
      "type": "object",
      "description": "Importance weights used to build coverage denominators for site-level checks.",
      "minProperties": 1,
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/category"
      }
    },
    "caps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cap"
      },
      "default": []
    },
    "gates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/gate"
      },
      "default": []
    },
    "bands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "min",
          "max",
          "label_ko",
          "label_en"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "min": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "max": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "label_ko": {
            "type": "string"
          },
          "label_en": {
            "type": "string"
          },
          "description_ko": {
            "type": "string"
          }
        }
      }
    },
    "sampling": {
      "type": "object",
      "description": "비싸거나 느린 측정을 어디까지 할 것인가. 코드가 정하면 그 숫자를 나중에 아무도 변호하지 못하므로 명세가 정한다.",
      "properties": {
        "perf_lab": {
          "type": "object",
          "required": [
            "max_urls",
            "min_measured_ratio"
          ],
          "additionalProperties": false,
          "properties": {
            "max_urls": {
              "type": "integer",
              "minimum": 1
            },
            "min_measured_ratio": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "rationale_ko": {
              "type": "string"
            },
            "check_ids": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true,
              "description": "이 표본 정책이 적용되는 검사. NOT_SAMPLED 가 허용되는 유일한 목록이다 — 여기 없는 검사에 붙이면 평가기가 오류를 낸다."
            }
          }
        },
        "perf_field": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "prefer_origin_scope": {
              "type": "boolean"
            },
            "rationale_ko": {
              "type": "string"
            },
            "check_ids": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true,
              "description": "이 표본 정책이 적용되는 검사. NOT_SAMPLED 가 허용되는 유일한 목록이다 — 여기 없는 검사에 붙이면 평가기가 오류를 낸다."
            }
          }
        }
      },
      "additionalProperties": false
    },
    "measurement_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_pages",
        "max_depth",
        "template_group_sample",
        "truncated_absence"
      ],
      "description": "이 명세가 무엇을 얼마나 재는가 — 크롤 범위의 발행 선언(1.9.0 신설). 점수의 분모가 무엇이었는지는 점수의 일부다.",
      "properties": {
        "max_pages": {
          "type": "integer",
          "minimum": 1
        },
        "max_depth": {
          "type": "integer",
          "minimum": 1
        },
        "template_group_sample": {
          "type": "integer",
          "minimum": 1
        },
        "truncated_absence": {
          "type": "string",
          "enum": [
            "UNKNOWN"
          ]
        },
        "rationale_ko": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "unitInterval": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "checkId": {
      "type": "string",
      "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)+$"
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "weight",
        "name_ko",
        "name_en",
        "checks"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "weight": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "name_ko": {
          "type": "string"
        },
        "name_en": {
          "type": "string"
        },
        "description_ko": {
          "type": "string"
        },
        "contributes_to_score": {
          "type": "boolean",
          "description": "이 영역이 준비도 점수를 이루는가. false 인 영역은 판정하고 보고하되 점수와 분모에서 모두 빠진다 — 연동이 있어야만 잴 수 있는 영역이 그렇다.",
          "default": true
        },
        "is_gate": {
          "type": "boolean",
          "description": "이 영역이 관문인가. true 이면 점수를 더하지 않고 곱한다 — 도달률 = 곱(1 − 실패 비율). 색인이 막힌 페이지의 완벽한 구조화 데이터는 아무 일도 하지 않으므로, 앞 단계의 차단은 뒤 단계의 점수를 배점만큼 깎는 것이 아니라 통째로 무효로 만든다. 선언하지 않으면 false 이고, 기존 명세는 그대로 가산 방식으로 동작한다."
        },
        "raw_budget": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "이 영역의 고정 분모. 선언하면 이 영역 검사들의 points 합이 정확히 이 값과 같아야 하며, 검사를 추가할 때 형제에서 덜어내야 한다. 선언하지 않으면 분모는 채점된 검사들의 심각도 계수 합이고 검사를 더할 때마다 자란다."
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/check"
          }
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title_ko",
        "title_en",
        "severity",
        "scope",
        "remediation_owner"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/checkId"
        },
        "title_ko": {
          "type": "string"
        },
        "title_en": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": [
            "BLOCKER",
            "CRITICAL",
            "MAJOR",
            "MINOR",
            "INFO"
          ]
        },
        "scope": {
          "type": "string",
          "enum": [
            "URL",
            "SITE"
          ],
          "description": "URL checks are evaluated per URL; SITE checks aggregate importance-weighted URL coverage."
        },
        "remediation_owner": {
          "type": "string",
          "enum": [
            "DEVELOPER",
            "MARKETER",
            "BUSINESS_OWNER",
            "OPERATIONS"
          ]
        },
        "applicability_ko": {
          "type": "string"
        },
        "evidence_required": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "engine_scope": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "GOOGLE",
              "NAVER",
              "BING",
              "AI_ANSWER_ENGINE",
              "GENERIC"
            ]
          },
          "default": [
            "GENERIC"
          ]
        },
        "reference_ko": {
          "type": "string"
        },
        "availability": {
          "type": "string",
          "enum": [
            "SELF_SERVICE",
            "CUSTOMER_GRANTED",
            "PAID_PROVIDER",
            "REFERENCE_ONLY"
          ],
          "default": "SELF_SERVICE",
          "description": "Who must act before this check can be measured, and whether it counts. SELF_SERVICE: VEO measures it on its own, with its own crawl or its own API key — it always counts toward the score. CUSTOMER_GRANTED: the site owner must grant access (Search Console, Naver Search Advisor). PAID_PROVIDER: a paid or separately configured data source. REFERENCE_ONLY: VEO can gather something here, but not well enough to score it — the reading is partial (one search engine, not the whole web) or cannot be attributed with confidence (a similarly named business). It is shown as reference and marked as needing separate human verification. Saying 'a paid service is required' when the real limit is coverage would put the ball in the customer's court for something that is not theirs to fix. Everything except SELF_SERVICE sits outside the diagnosis, so it leaves the denominator rather than scoring zero — a score must not be lowered by a permission the customer has not been asked for, nor by a reading we ourselves do not trust. All of them are still reported, by name and with what would settle them."
        },
        "points": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "이 검사가 자기 영역 안에서 갖는 명시적 배점. 쓰려면 영역이 raw_budget 을 함께 선언해야 한다. 없으면 배점은 심각도 다섯 단계에서 나온다."
        }
      }
    },
    "cap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "max_overall_score",
        "reason_ko",
        "release_condition_ko",
        "trigger"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "max_overall_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "reason_ko": {
          "type": "string"
        },
        "release_condition_ko": {
          "type": "string"
        },
        "trigger": {
          "$ref": "#/$defs/trigger"
        }
      }
    },
    "gate": {
      "type": "object",
      "description": "A gate never changes the numeric score. It raises a separate status shown next to it.",
      "additionalProperties": false,
      "required": [
        "id",
        "status_code",
        "label_ko",
        "label_en",
        "trigger"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "status_code": {
          "type": "string",
          "pattern": "^[A-Z0-9_]+$"
        },
        "label_ko": {
          "type": "string"
        },
        "label_en": {
          "type": "string"
        },
        "description_ko": {
          "type": "string"
        },
        "trigger": {
          "$ref": "#/$defs/trigger"
        }
      }
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "any_of"
      ],
      "properties": {
        "any_of": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "check_id",
              "status"
            ],
            "properties": {
              "check_id": {
                "$ref": "#/$defs/checkId"
              },
              "status": {
                "type": "string",
                "enum": [
                  "PASS",
                  "WARNING",
                  "FAIL",
                  "NOT_APPLICABLE",
                  "UNKNOWN"
                ]
              },
              "min_coverage": {
                "$ref": "#/$defs/unitInterval",
                "description": "Optional: only trigger when the affected coverage ratio reaches this value."
              }
            }
          }
        }
      }
    }
  }
}
