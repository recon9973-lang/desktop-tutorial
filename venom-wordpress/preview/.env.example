# ============================================================
# 베놈 사이트 — 환경변수 단일 템플릿 (.env.example)
# ============================================================
# 이 파일이 사이트가 실제로 읽는 모든 키의 "단일 소스"입니다.
# - 값은 절대 커밋 금지. 실제 값은 Vercel 프로젝트 env 또는 시크릿 매니저에만.
# - "정규명"을 우선 사용하세요. 별칭(alias)은 예전 등록분 호환용으로 코드가 함께 허용합니다.
# - 코드 근거: api/*.js, lib/*.js 의 process.env.* 실측(2026-07) 기준.
# ============================================================

# ─────────────── AI / LLM 엔진 ───────────────
# 콘텐츠 생성(글·이미지·번역)
OPENAI_API_KEY=                       # [필수] 글/이미지 생성
OPENAI_TEXT_MODEL=gpt-4o-mini         # (선택·시크릿 아님)
OPENAI_SEARCH_MODEL=                  # (선택)
OPENAI_IMAGE_MODEL=gpt-image-1        # (선택)
OPENAI_IMAGE_QUALITY=                 # (선택)
OPENAI_IMAGE_COMPRESSION=             # (선택)

# AI 노출 진단(멀티엔진) — 각 엔진은 해당 키가 있을 때만 측정에 참여
PERPLEXITY_API_KEY=                   # Perplexity 엔진
PERPLEXITY_MODEL=                     # (선택)
ANTHROPIC_API_KEY=                    # Claude 엔진
ANTHROPIC_MODEL=                      # (선택)
GEMINI_API_KEY=                       # Gemini 엔진   (별칭: GOOGLE_AI_KEY)
GEMINI_MODEL=                         # (선택)

# ─────────────── 네이버 ───────────────
# 검색 API — 데이터랩 트렌드 / 블로그·카페 문서량
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 검색광고 키워드도구(월 검색량·경쟁도) — 정규명 NAVER_AD_* 사용 권장
NAVER_AD_API_KEY=                     # (별칭: NAVER_ACCESS_LICENSE)
NAVER_AD_SECRET=                      # (별칭: NAVER_SECRET_KEY)
NAVER_AD_CUSTOMER_ID=                 # (별칭: NAVER_CUSTOMER_ID)

# ─────────────── Google ───────────────
PSI_KEY=                              # PageSpeed Insights — 속도/기술 진단

# ─────────────── GitHub (콘텐츠 영속 저장소 = DB 계층) ───────────────
GITHUB_TOKEN=                         # [필수] 글·설정 JSON 저장/커밋
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main

# ─────────────── Airtable (무료진단 리드 접수) ───────────────
AIRTABLE_TOKEN=                       # [리드용] 신청접수 기록  (별칭: AIRTABLE_API_KEY)
AIRTABLE_LEAD_BASE=appR2NeAuARbojdPs  # 기본값=베놈 무료진단 접수 베이스(재정의 가능)
AIRTABLE_LEAD_TABLE=tblSE4a5JrqggAiVR # 기본값=신청접수 테이블(재정의 가능)

# ─────────────── KV / 방문자 분석 (Vercel KV = Upstash) ───────────────
KV_REST_API_URL=                      # (별칭: UPSTASH_REDIS_REST_URL)
KV_REST_API_TOKEN=                    # (별칭: UPSTASH_REDIS_REST_TOKEN)

# ─────────────── 보안 / 운영 ───────────────
ADMIN_SECRET=                         # 관리자 쓰기(발행/설정) 인증
CRON_SECRET=                          # Vercel Cron 인증 (자동발행·SEO모니터)

# ─────────────── 기타(선택) ───────────────
SITE_URL=                             # 정식 주소(선택). 미설정 시 VERCEL_URL 사용
# VERCEL_URL 은 Vercel이 자동 주입 — 직접 설정하지 마세요
GROWTHOPS_MONITOR_URLS=               # SEO 모니터 대상 도메인(쉼표구분, 선택)
LB_DISCLOSURE=                        # 링크빌딩 아웃리치 공시 문구(선택)

# ============================================================
# 별칭 정책 요약 (코드가 정규명 → 별칭 순으로 폴백)
#   NAVER_AD_API_KEY      ← NAVER_ACCESS_LICENSE
#   NAVER_AD_SECRET       ← NAVER_SECRET_KEY
#   NAVER_AD_CUSTOMER_ID  ← NAVER_CUSTOMER_ID
#   GEMINI_API_KEY        ← GOOGLE_AI_KEY
#   AIRTABLE_TOKEN        ← AIRTABLE_API_KEY
#   KV_REST_API_URL/TOKEN ← UPSTASH_REDIS_REST_URL/TOKEN
# → 신규 등록은 반드시 정규명으로. 별칭은 이관 완료 후 제거 예정.
# ============================================================
