+  b: { readonly code: ChannelCode; readonly citations: number },
+): number {
+  const aLast = a.code === 'UNCLASSIFIED';
+  const bLast = b.code === 'UNCLASSIFIED';
+  if (aLast !== bLast) return aLast ? 1 : -1;
+  return b.citations - a.citations || a.code.localeCompare(b.code);
+}
