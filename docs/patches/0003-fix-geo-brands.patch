+class TestANarrowPlanIsNotACompletePlan:
+    """**「계획을 다 했나」와 「계획이 좁았나」는 다른 사실이다.**
+
+    [실측 2026-09-09] 거래처 한 판이 일곱 중 ChatGPT 하나에만 물었다. 계획을 다
+    채웠으므로 `is_complete` 가 참이었고, 그래서 **어느 값에도 그 사실이 안 붙었다** —
+    화면은 그 판의 언급률을 일곱에 다 물은 판과 같은 무게로 그렸다.
+    """
+
+    def test_asking_one_of_seven_says_so(self) -> None:
+        answers = [_answer(prompt=f"q{n}", mentioned=True) for n in range(3)]
+
+        result = visibility_metrics(
+            answers,
+            prompts_planned=3,
+            run_is_complete=True,
+            engines_asked=("OPENAI",),
+            engines_known=("OPENAI", "ANTHROPIC", "GOOGLE_GEMINI"),
+        )
+
+        note = next(one for one in result.caveats_ko if "아는 AI" in one)
+        assert "3 곳 가운데 1 곳" in note
+        # 안 물은 곳의 0 은 0 이 아니다(ADR 0002).
+        assert "진단 못 함" in note
+        # **부분 측정과 섞지 않는다** — 계획은 다 했다.
+        assert not result.is_partial_measurement
+
+    def test_asking_every_engine_says_nothing(self) -> None:
+        answers = [_answer(prompt="q1", mentioned=True)]
+
+        result = visibility_metrics(
+            answers,
+            prompts_planned=1,
+            run_is_complete=True,
+            engines_asked=("OPENAI", "ANTHROPIC"),
+            engines_known=("OPENAI", "ANTHROPIC"),
+        )
+
+        assert not any("아는 AI" in one for one in result.caveats_ko)
+
+    def test_not_knowing_the_engine_list_says_nothing(self) -> None:
+        """빈 목록은 「좁지 않았다」가 아니라 **못 잰 것**이다. 지어내지 않는다."""
+        answers = [_answer(prompt="q1", mentioned=True)]
+
+        result = visibility_metrics(answers, prompts_planned=1, run_is_complete=True)
+
+        assert not any("아는 AI" in one for one in result.caveats_ko)
+
