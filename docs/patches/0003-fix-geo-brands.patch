+ * 수 있고(그러면 부분 측정이 아니다), 그래도 **물어본 곳이 좁았다**는 것은 따로 참이다.
+ * 그래서 부분 측정 표시에 섞지 않고 제 문장으로 적는다.
+ */
+function EnginesAsked({ columns }: { readonly columns: readonly EngineColumn[] }) {
+  const known = columns.length;
+  const asked = columns.filter((one) => one.state !== 'NOT_RUN').length;
+  // 다 물었으면 할 말이 없다. 「일곱 중 일곱」은 줄을 차지할 값이 아니다.
+  if (known === 0 || asked >= known) return null;
+
+  return (
+    <p className={styles.rateNote}>
+      이 판은 <strong>아는 AI {known} 중 {asked}</strong> 에만 물었습니다.{' '}
+      나머지 {known - asked} 은 0 이 아니라 <strong>{NOT_MEASURED} 못 잼</strong>입니다.
+    </p>
+  );
+}
