+    까닭으로 서 있다. 그래서 이어 붙이는 자리를 하나로 둔다.
+    """
+    declared = _checked_domains(values)
+    _reject_rented_hosts(session, principal, declared)
+    return declared
+
+
+def _reject_rented_hosts(
+    session: Session, principal: Principal, declared: list[str]
+) -> None:
+    """경로 없이 선언한 호스트를 **우리 DB 가 아는 임대형인지** 대조한다.
+
+    「임대형」의 판정은 짐작이 아니라 **자리 수**다 — 그 호스트를 쓰는 자리가 서로 다른
+    거래처 둘 이상에 걸쳐 있으면 임대형이다(`shared_hosts.sql` 과 같은 셈).
+
+    한 거래처가 같은 호스트에 자리를 여럿 둔 것은 임대형이 아니다. 그것까지 막으면
+    멀쩡한 선언이 거절된다.
+    """
+    hosts = {
+        rule.host
+        for rule in (OwnDomainRule.parse(one) for one in declared if one.strip())
+        if rule.path_prefix == "/"
+    }
+    if not hosts:
+        return
+
+    # `origin` 은 스킴+호스트로 저장된다(`veo.sites.schemas`). 꼬리표 검색(`like`)은
+    # `notgrand1.co.kr` 까지 잡으므로, 있을 수 있는 꼴을 만들어 **정확히** 견준다.
+    candidates = {
+        f"{scheme}://{prefix}{host}"
+        for host in hosts
+        for scheme in ("https", "http")
+        for prefix in ("", "www.")
+    }
+    statement = (
+        tenant_select(Site, principal)
+        .join(Project, Project.id == Site.project_id)
+        # **이어 붙인 표에도 조직 자물쇠를 건다.** `tenant_select` 는 처음 표만 잠그고,
+        # 관문(`authz/tenancy.py`)이 나머지를 잡아 준다 — 실제로 여기서 걸렸다.
+        .where(Project.organization_id == principal.organization_id)
+        .where(Site.origin.in_(candidates))
+    )
+    assert_tenant_scoped(statement, principal.organization_id)
+
+    tenants: dict[str, set[uuid.UUID]] = {}
+    paths: dict[str, set[str]] = {}
+    for site, customer_id in session.execute(
+        statement.with_only_columns(Site, Project.customer_id)
+    ):
+        host = site.origin.split("://", 1)[-1].removeprefix("www.").lower()
+        if customer_id is not None:
+            tenants.setdefault(host, set()).add(customer_id)
+        paths.setdefault(host, set()).add(site.base_path or "/")
+
+    for host in sorted(hosts):
+        if len(tenants.get(host, ())) < 2:
+            continue
+        listed = " · ".join(sorted(paths.get(host, {"/"})))
+        raise RentedHostError(
+            f"'{host}' 은(는) 이미 업체 {len(tenants[host])} 곳이 경로로 나눠 쓰는 "
+            f"홈페이지입니다(자리: {listed}).\n\n"
+            f"호스트만 선언하면 **옆 업체 페이지의 인용까지 우리 것으로 세어집니다** — "
+            f"없는 노출이 생기고, 그것도 유리한 방향이라 아무도 이의를 제기하지 않습니다. "
+            f"'{host}/우리경로' 처럼 **경로까지** 넣으면 그 아래만 우리 것으로 셉니다."
