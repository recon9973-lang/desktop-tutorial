+++ b/apps/api/tests/brands/test_rented_host_postgres.py
@@ -0,0 +1,199 @@
+"""한 홈페이지를 여러 업체가 나눠 쓸 때, **경로 없는 자사 선언을 막는다.**
+
+## 왜 이 시험이 생겼나
+
+`domains.py` 의 공유 플랫폼 목록은 네이버·티스토리·카카오채널처럼 **누구나 아는** 곳을
+손으로 적어 둔 것이다. 그 목록은 `grand1.co.kr` 같은 **업체 자체 임대형 호스트**를
+영원히 담지 못한다 — 남의 플랫폼이 아니라 그 병원들의 홈페이지다.
+
+```
+[실측 2026-08-28 · 사장님 정정] grand1.co.kr 아래 네 자리
+    /pediatrics/  배내과    /orthopedics/  연합의원
+    /ophthalmology/ 우리안과 /skin/        피부
+```
+
+**그런데 우리는 이미 안다.** `sites` 에 자리마다 `origin` 과 `base_path` 가 있다
+(`Site.base_path` 는 2026-08-13 에 바로 이 병원 때문에 생겼다). 호스트만 선언하면
+형제 의원의 인용이 전부 우리 것으로 세어지고, **그것도 유리한 방향이라 아무도 이의를
+제기하지 않는다.**
+
+판정기(`OwnDomainRule`)는 경로를 이미 지원한다. 고장난 것은 저장 한 곳뿐이다.
+"""
+
+from __future__ import annotations
+
+import uuid
+from collections.abc import Iterator
+
+import pytest
+from sqlalchemy import delete, select
+from sqlalchemy.orm import Session
+
+from veo.authz.principal import Principal
+from veo.brands.service import RentedHostError, declare_brand, update_brand
+from veo.contracts.enums import Role
+from veo.db.models.identity import Customer, Organization, Project, Site
+from veo.db.models.observation import BrandIdentity
+
+pytestmark = pytest.mark.requires_postgres
+
+#: 한 호스트를 나눠 쓰는 자리들. 값은 운영에서 옮겨 적은 모양 그대로다.
+RENTED = "grand1.co.kr"
+
+
+class Building:
+    """한 조직 · 거래처 셋 · 같은 호스트에 경로가 다른 자리 셋 · 남의 호스트 하나."""
+
+    def __init__(self, db: Session) -> None:
+        suffix = uuid.uuid4().hex[:8]
+        self.organization = Organization(
+            slug=f"veo-rented-{suffix}", name="임대형 시험", is_active=True, settings={}
+        )
+        db.add(self.organization)
+        db.flush()
+
+        self.projects: list[Project] = []
+        for path, name in (
+            ("/pediatrics/", "배내과"),
+            ("/orthopedics/", "연합의원"),
+            ("/ophthalmology/", "우리안과"),
+        ):
+            customer = Customer(
+                organization_id=self.organization.id, name=f"{name}-{suffix}"
+            )
+            db.add(customer)
+            db.flush()
+            project = Project(
+                organization_id=self.organization.id,
+                customer_id=customer.id,
+                slug=f"proj-{name}-{suffix}",
+                name=name,
+                locale="ko-KR",
+                settings={},
+            )
+            db.add(project)
+            db.flush()
+            db.add(
+                Site(
+                    organization_id=self.organization.id,
+                    project_id=project.id,
+                    origin=f"https://www.{RENTED}",
+                    base_path=path,
+                    display_name=name,
+                    is_primary=True,
+                    crawl_settings={},
+                )
+            )
+            self.projects.append(project)
+
+        # 혼자 쓰는 호스트 — 여기는 경로 없이 선언해도 막을 까닭이 없다.
+        alone = Customer(organization_id=self.organization.id, name=f"단독-{suffix}")
+        db.add(alone)
+        db.flush()
+        self.alone_project = Project(
+            organization_id=self.organization.id,
+            customer_id=alone.id,
+            slug=f"proj-alone-{suffix}",
+            name="단독",
+            locale="ko-KR",
+            settings={},
+        )
+        db.add(self.alone_project)
+        db.flush()
+        self.alone_host = f"solo-{suffix}.example"
+        db.add(
+            Site(
+                organization_id=self.organization.id,
+                project_id=self.alone_project.id,
+                origin=f"https://{self.alone_host}",
+                base_path="",
+                display_name="단독",
+                is_primary=True,
+                crawl_settings={},
+            )
+        )
+        db.flush()
+
+    @property
+    def analyst(self) -> Principal:
+        return Principal(
+            user_id=uuid.uuid4(),
+            organization_id=self.organization.id,
+            roles=frozenset({Role.ANALYST}),
+            session_id="rented-host-session",
+        )
+
+
+@pytest.fixture
+def building(db: Session) -> Iterator[Building]:
+    made = Building(db)
+    db.commit()
+    yield made
+    db.rollback()
+    db.execute(delete(Organization).where(Organization.id == made.organization.id))
+    db.commit()
+
+
+def _declare(db: Session, building: Building, project: Project, domain: str) -> None:
+    declare_brand(
+        db,
+        building.analyst,
+        project.id,
+        display_name=f"브랜드-{uuid.uuid4().hex[:6]}",
+        is_own_brand=True,
+        aliases=[],
+        own_domains=[domain],
+        address_terms=[],
+        phone_numbers=[],
+        distinguishing_terms=[],
+    )
+
+
+class TestARentedHostNeedsAPath:
+    def test_declaring_the_bare_host_is_refused(
+        self, db: Session, building: Building
+    ) -> None:
+        with pytest.raises(RentedHostError) as refused:
+            _declare(db, building, building.projects[0], f"https://www.{RENTED}/")
+        db.rollback()
+
+        message = str(refused.value)
+        # 몇 곳이 나눠 쓰는지와 **어느 자리들인지**를 함께 말한다. 그래야 제 경로를 고른다.
+        assert "3 곳" in message
+        assert "/pediatrics/" in message
+        assert "경로까지" in message
+
+    def test_declaring_with_a_path_goes_through(
+        self, db: Session, building: Building
+    ) -> None:
+        _declare(db, building, building.projects[0], f"https://www.{RENTED}/pediatrics/")
+        db.flush()
+
+    def test_a_host_only_one_customer_uses_is_untouched(
+        self, db: Session, building: Building
+    ) -> None:
+        """혼자 쓰는 호스트는 지금까지와 똑같이 도메인 전체다.
+
+        이 규칙이 바뀌면 이미 등록된 거래처의 지난 관측과 이번 관측이 다른 자로 재진다
+        (`test_own_domain_per_department.py` 의 마지막 시험이 같은 것을 지킨다).
+        """
+        _declare(db, building, building.alone_project, f"https://{building.alone_host}/")
+        db.flush()
+
+    def test_the_patch_path_is_checked_too(
+        self, db: Session, building: Building
+    ) -> None:
+        """**나중에 채워 넣는 경로**로 그대로 들어오면 막은 것이 아니다."""
+        _declare(db, building, building.projects[1], f"https://www.{RENTED}/orthopedics/")
+        db.flush()
+        brand = db.scalars(
+            select(BrandIdentity).where(
+                BrandIdentity.project_id == building.projects[1].id
+            )
+        ).one()
+
+        with pytest.raises(RentedHostError):
+            update_brand(
+                db, building.analyst, brand.id, own_domains=[f"https://www.{RENTED}/"]
+            )
+        db.rollback()
