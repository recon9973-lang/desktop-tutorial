# ============================================================
# 베놈 생태계 — 통합 .env 템플릿 (정규화된 키 이름)
# 값은 절대 커밋 금지. 실제 값은 시크릿 매니저에 두고 여기엔 빈칸만.
# 프로젝트별로 필요한 블록만 복사해서 각 앱의 .env로 사용.
# ============================================================

# ---------- [공유] AI / LLM ----------
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# 모델 설정(시크릿 아님, 선택)
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_SEARCH_MODEL=
OPENAI_IMAGE_MODEL=gpt-image-1

# ---------- [공유] 네이버 ----------
# 검색 API (블로그/웹/쇼핑)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 검색광고 키워드도구 (정규 이름 — NAVER_ACCESS_LICENSE 등 구이름 폐기)
NAVER_AD_API_KEY=
NAVER_AD_SECRET=
NAVER_AD_CUSTOMER_ID=

# ---------- [공유] 카카오 ----------
KAKAO_API_KEY=
KAKAO_SENDER_KEY=
KAKAO_TEMPLATE_RECOMMENDATION=
KAKAO_TEMPLATE_REMINDER=
NEXT_PUBLIC_KAKAO_MAP_KEY=

# ---------- [베놈사이트] 구글 / 저장 / 운영 ----------
PSI_KEY=
GSC_SERVICE_ACCOUNT_JSON=
GSC_SITE_URL=
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main
KV_REST_API_URL=
KV_REST_API_TOKEN=
ADMIN_SECRET=
CRON_SECRET=
SITE_URL=

# ---------- [ERP] 인프라 / 인증 ----------
DATABASE_URL=
AUTH_SECRET=
AUTH_URL=
EMAIL_SERVER=
EMAIL_FROM=
CREDENTIAL_ENC_KEY=
KW_PROXY_URL=
# 결제·은행·캘린더 (기능 연기 — 필요 시)
# TOSSPAYMENTS_SECRET_KEY=
# INICIS_MID=
# KAKAOPAY_ADMIN_KEY=
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
# NAVER_CALENDAR_CLIENT_ID=
# NAVER_CALENDAR_CLIENT_SECRET=

# ---------- [영양제] 앱 / 공공데이터 ----------
EXPO_PUBLIC_API_BASE=http://localhost:3000
# DATA_GO_KR_KEY=
# NCBI_API_KEY=
# GOOGLE_VISION_API_KEY=
# CLOVA_OCR_INVOKE_URL=
# CLOVA_OCR_SECRET=

# ---------- [seo-generator] ----------
# OPENAI_API_KEY 위 공유 블록 사용
OPENAI_MODEL=gpt-5.5
HOST=127.0.0.1
PORT=4173
